# ── システム ────────────────────────────────────────────────────────────────────
APP_URL=https://hisui-ai.com
ADMIN_EMAIL=

# ── データベース (NeonDB) ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://..."

# ── ストレージ (Cloudflare R2) ───────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=hisui-editor
CLOUDFLARE_R2_PUBLIC_URL=https://assets.hisui-ai.com

# ── メール (Resend) ──────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── 動画書き出し (ShotStack) ─────────────────────────────────────────────────────
# サンドボックス（透かしあり・無料）
SHOTSTACK_API_KEY=
SHOTSTACK_API_URL=https://api.shotstack.io/edit/stage
# 本番（透かしなし・有料プラン）
SHOTSTACK_PROD_API_KEY=
SHOTSTACK_PROD_API_URL=https://api.shotstack.io/edit/v1

# ── AI生成 — テキスト / スクリプト ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
ARK_API_KEY=

# ── AI生成 — 画像 ────────────────────────────────────────────────────────────────
REVE_API_KEY=
IMAGE_GEN_WORKER_URL=https://your-image-worker.workers.dev
IMAGE_GEN_MODEL=seedream-5-0-260128

# ── AI生成 — 動画 (Google Veo) ───────────────────────────────────────────────────
GOOGLE_AI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_LITE_MODEL=veo-3.1-lite-generate-preview

# PPTX変換 (Cloud Run)
PPTX_CONVERTER_URL=
CONVERTER_SHARED_SECRET=

# ログイン（Google / Microsoft / メールリンク）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AUTH_LINK_SECRET=

# Cloudflare Turnstile（ロボット対策。未設定なら確認を飛ばす）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

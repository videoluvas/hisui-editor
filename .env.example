# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=https://assets.your-domain.com

# Shotstack
SHOTSTACK_API_KEY=
SHOTSTACK_API_URL=https://api.shotstack.io/edit/stage

# Anthropic
ANTHROPIC_API_KEY=

# Reve AI (画像生成)
REVE_API_KEY=

# Image Generation
IMAGE_GEN_WORKER_URL=https://your-image-worker.workers.dev
IMAGE_GEN_MODEL=seedream-5-0-260128

# Admin
ADMIN_EMAIL=admin@example.com

# BytePlus ARK (Seedance動画生成)
ARK_API_KEY=

# Google AI (Veo動画生成)
GOOGLE_AI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_LITE_MODEL=veo-3.1-lite-generate-preview
